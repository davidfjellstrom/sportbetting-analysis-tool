# ---------------------------------------------------------------------------
# Never commit the exports. They contain personal financial information.
# See CLAUDE.md -> Privacy.
# ---------------------------------------------------------------------------
# Ignore the raw exports, keep the directory so a fresh clone has somewhere
# to put them. (Ignoring `data/raw/` itself would hide the .gitkeep too: git
# does not descend into an ignored directory.)
data/raw/*
!data/raw/.gitkeep
*.csv
*.parquet
*.xlsx

# The processed exports are committed: every amount is in notional units
# (see README -> Units), and they are what the deployed app reads.
!data/processed/*.csv

# Reports may embed real monetary values
reports/*
!reports/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Agent tooling: symlinks into .venv created by the streamlit package
.claude/
.agents/
.vercel
